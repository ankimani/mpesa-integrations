{
  "info": {
    "name": "Payment Gateway YouTube Demo",
    "_postman_id": "d95f4c17-f15c-4f3b-9445-9d5fd6f8d0e4",
    "description": "Minimal requests for STK push, callback, and transactions list demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "STK Push",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"254712345678\",\n  \"amount\": 1,\n  \"clientReference\": \"INV-1001\",\n  \"transactionDescription\": \"Demo Payment\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/stk-push",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments",
            "stk-push"
          ]
        }
      }
    },
    {
      "name": "List Transactions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/transactions?page=1&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments",
            "transactions"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "List Transactions (Completed)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/transactions?page=1&size=20&status=COMPLETED",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments",
            "transactions"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "size",
              "value": "20"
            },
            {
              "key": "status",
              "value": "COMPLETED"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}
